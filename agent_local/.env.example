AGENT_EMPRESA_ID=12345678000199
AGENT_API_BASE_URL=https://movisystecnologia.com.br/admin/api
AGENT_API_KEY=
AGENT_PAIRING_CODE=
AGENT_DEVICE_LABEL=loja-01
# Opcional fallback se nao usar Windows Credential Manager.
AGENT_MANUAL_CONFIG_PASSWORD=
AGENT_MARIADB_URL=mysql+pymysql://root:root@127.0.0.1:3308/xd
# auto detecta salesdocumentsreportview e envia campos canonicos de relatorio:
# terminal_code, tipo_venda, forma_pagamento e familia_produto quando existirem.
AGENT_SOURCE_QUERY=auto
SYNC_INTERVAL_MINUTES=15
BATCH_SIZE=500
TIMEOUT_SECONDS=30
VERIFY_SSL=true
CHECKPOINT_FILE=agent_local/data/checkpoints.json
AGENT_API_KEY_FILE=agent_local/data/agent_api_key.txt
LOCAL_ORDER_DB_PATH=agent_local/data/local_orders.db
LOCAL_API_TOKEN_FILE=agent_local/data/local_api_token.txt
LOCAL_ORDER_AUTO_REFRESH_CATALOG=true
LOCAL_ORDER_PUSH_XD_ENABLED=true
LOCAL_ORDER_XD_TERMINAL_ID=1
LOCAL_ORDER_PRINT_JOBS_DIR=agent_local/data/print_jobs
LOCAL_ORDER_RECEIPT_WIDTH=32
# Nome exato da impressora termica no Windows. Se vazio, gera job local sem enviar ao spool.
LOCAL_ORDER_PRINTER_NAME=
LOG_LEVEL=INFO
